@page "/"
@rendermode InteractiveServer
@using GitHubAgent.Services
@inject GitHubAgentService AgentService

<PageTitle>GitHub Agent</PageTitle>

<div class="container">
    <h1>GitHub MCP Agent</h1>

    <div class="chat-shell">
        <div class="chat-history">
            @foreach (var message in Messages)
            {
                <div class="message @message.Role">
                    <div class="message-header">
                        <span class="message-role">@message.RoleLabel</span>
                        @if (message.ToolsUsed.Count > 0)
                        {
                            <span class="message-tools">Tools: @string.Join(", ", message.ToolsUsed)</span>
                        }
                    </div>
                    <div class="message-body">@message.Text</div>
                </div>
            }
        </div>

        <div class="chat-input">
            <textarea @bind="InputText" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Írj egy GitHub kérdést..." rows="3"></textarea>
            <div class="chat-actions">
                <button @onclick="SendMessage" disabled="@IsBusy">@SendButtonText</button>
                <button @onclick="ClearChat" disabled="@IsBusy">Törlés</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="status">@StatusMessage</div>
            }
        </div>
    </div>
</div>

@code {
    private string InputText { get; set; } = string.Empty;
    private List<ChatMessage> Messages { get; set; } = new();
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;

    private string SendButtonText => IsBusy ? "Küldés..." : "Küldés";

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(InputText))
        {
            return;
        }

        var command = InputText.Trim();
        Messages.Add(ChatMessage.CreateUser(command));
        _chatHistory.Add(new GitHubAgentService.ChatTurn(GitHubAgentService.ChatRole.User, command));
        InputText = string.Empty;
        StatusMessage = "Feldolgozás...";
        IsBusy = true;
        StateHasChanged();

        try
        {
            var response = await AgentService.RunAgentAsync(BuildHistory());
            Messages.Add(ChatMessage.CreateAssistant(response.Content, response.ToolsUsed));
            _chatHistory.Add(new GitHubAgentService.ChatTurn(GitHubAgentService.ChatRole.Assistant, response.Content));
        }
        finally
        {
            IsBusy = false;
            StatusMessage = string.Empty;
        }
    }

    private void ClearChat()
    {
        if (IsBusy)
        {
            return;
        }

        Messages.Clear();
        _chatHistory.Clear();
    }

    private readonly List<GitHubAgentService.ChatTurn> _chatHistory = new();

    private IReadOnlyList<GitHubAgentService.ChatTurn> BuildHistory()
    {
        return _chatHistory;
    }

    private sealed class ChatMessage
    {
        public string Text { get; init; } = string.Empty;
        public string Role { get; init; } = "assistant";
        public string RoleLabel => Role == "user" ? "Te" : "Agent";
        public IReadOnlyList<string> ToolsUsed { get; init; } = Array.Empty<string>();

        public static ChatMessage CreateUser(string text)
        {
            return new ChatMessage { Text = text, Role = "user" };
        }

        public static ChatMessage CreateAssistant(string text, IReadOnlyList<string> tools)
        {
            return new ChatMessage { Text = text, Role = "assistant", ToolsUsed = tools };
        }
    }
}
