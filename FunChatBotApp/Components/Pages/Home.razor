@page "/"
@using FunChatBotApp.Models
@using FunChatBotApp.Services
@using Markdig
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject ChatService ChatSvc
@inject DocumentService DocSvc
@inject CosmosDbService CosmosDb
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>AI Chat Workspace</PageTitle>

<div class="container-fluid d-flex h-100 p-3 pt-0 workspace-container">
    <div class="row flex-grow-1 w-100 bg-white rounded-4 shadow-sm border overflow-hidden">
        <!-- Sidebar / Workspace Menu -->
        <Sidebar StandaloneChats="standaloneChats"
                 Projects="projects"
                 ProjectChatsByProject="projectChatsByProject"
                 ActiveChat="activeChat"
                 OnCreateStandaloneChat="CreateStandaloneChat"
                 OnCreateProject="CreateProject"
                 OnCreateProjectChat="HandleCreateProjectChat"
                 OnSelectChat="HandleSelectChat" />

        <!-- Chat Area -->
        <ChatArea Projects="projects"
                  ActiveChat="activeChat"
                  ActiveProject="activeProject"
                  CurrentMessages="currentMessages"
                  IsTyping="isTyping"
                  IsProcessingFile="isProcessingFile"
                  IsMovingChat="isMovingChat"
                  UseDocumentContext="useDocumentContext"
                  OnFileSelected="HandleFileSelected"
                  OnClearDocument="ClearDocument"
                  OnSendMessage="SendMessage"
                  OnUseDocumentContextChanged="HandleUseDocumentContextChanged"
                  OnMoveToProject="HandleMoveToProject" />
    </div>
</div>

@code {
    private List<Project> projects = new();
    private List<ChatSession> standaloneChats = new();

    private Dictionary<string, List<ChatSession>> projectChatsByProject = new();
    private List<ChatMessage> currentMessages = new();

    private Project? activeProject = null;
    private ChatSession? activeChat = null;

    private bool useDocumentContext = false;
    private bool isTyping = false;
    private bool isProcessingFile = false;
    private bool isMovingChat = false;

    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userIdString))
        {
            currentUserId = userIdString;
            await LoadWorkspaceAsync();
        }
    }

    private async Task LoadWorkspaceAsync()
    {
        projects = await CosmosDb.GetProjectsAsync(currentUserId);
        standaloneChats = await CosmosDb.GetStandaloneChatsAsync(currentUserId);

        projectChatsByProject.Clear();
        foreach (var proj in projects)
        {
            var pChats = await CosmosDb.GetProjectChatsAsync(proj.Id, currentUserId);
            projectChatsByProject[proj.Id] = pChats;
        }
    }

    private async Task CreateStandaloneChat(string title)
    {
        isTyping = true;
        StateHasChanged();
        try
        {
            var chat = new ChatSession { Title = title };
            await CosmosDb.UpsertStandaloneChatAsync(chat, currentUserId);
            standaloneChats.Add(chat);

            // Új chat induláskor meghívjuk a Semantic Kernel ajánló logikát
            await ChatSvc.GenerateInitialRecommendationsAsync(chat, currentUserId);

            await HandleSelectChat((null, chat));
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }

    private async Task CreateProject(string name)
    {
        var proj = new Project { Name = name };
        await CosmosDb.UpsertProjectAsync(proj, currentUserId);
        projects.Add(proj);
    }

    private async Task HandleCreateProjectChat((Project Project, string Title) args)
    {
        isTyping = true;
        StateHasChanged();
        try
        {
            var pChat = new ChatSession { Title = args.Title };
            await CosmosDb.UpsertProjectChatAsync(pChat, args.Project.Id, currentUserId);

            if (!projectChatsByProject.ContainsKey(args.Project.Id))
                projectChatsByProject[args.Project.Id] = new List<ChatSession>();

            projectChatsByProject[args.Project.Id].Add(pChat);

            // Új projekt chat induláskor is meghívjuk az ajánló logikát
            await ChatSvc.GenerateInitialRecommendationsAsync(pChat, currentUserId);

            await HandleSelectChat((args.Project, pChat));
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }

    private async Task HandleSelectChat((Project? Project, ChatSession Chat) args)
    {
        activeProject = args.Project;
        activeChat = args.Chat;
        useDocumentContext = !string.IsNullOrEmpty(args.Chat.ActiveDocumentText);

        currentMessages.Clear();
        var projectIdForQueries = args.Project != null ? args.Project.Id : args.Chat.Id;
        currentMessages = await CosmosDb.GetChatMessagesAsync(projectIdForQueries, args.Chat.Id, currentUserId);
    }

    private async Task HandleMoveToProject(string targetProjectId)
    {
        if (activeChat == null || activeProject != null) return; // Csak egyedülálló (standalone) chatet mozgatunk
        var targetProject = projects.FirstOrDefault(p => p.Id == targetProjectId);
        if (targetProject == null) return;

        isMovingChat = true;
        StateHasChanged();
        try
        {
            await ChatSvc.MoveChatToProjectAsync(activeChat, targetProject, currentUserId);

            // Frissíteni kell a munkaterületet, hogy a menü és az elemek szinkronba kerüljenek
            await LoadWorkspaceAsync();

            // Kijelöljük a már áthelyezett chatet a projekt alatt
            var movedChat = projectChatsByProject[targetProject.Id].FirstOrDefault(c => c.Id == activeChat.Id);
            if (movedChat != null)
            {
                await HandleSelectChat((targetProject, movedChat));
            }
            else
            {
                activeChat = null;
                activeProject = null;
            }
        }
        catch (Exception ex)
        {
            currentMessages.Add(new FunChatBotApp.Models.ChatMessage { Role = "assistant", Content = $"Hiba az áthelyezés során: {ex.Message}" });
        }
        finally
        {
            isMovingChat = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (activeChat == null) return;

        isProcessingFile = true;
        try
        {
            using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            activeChat.ActiveDocumentText = await DocSvc.ExtractTextFromStreamAsync(stream);
            useDocumentContext = true;

            if (activeProject != null) await CosmosDb.UpsertProjectChatAsync(activeChat, activeProject.Id, currentUserId);
            else await CosmosDb.UpsertStandaloneChatAsync(activeChat, currentUserId);
        }
        catch (Exception ex)
        {
            activeChat.ActiveDocumentText = $"Hiba: {ex.Message}";
        }
        finally
        {
            isProcessingFile = false;
            StateHasChanged();
        }
    }

    private async Task ClearDocument()
    {
        if (activeChat != null)
        {
            activeChat.ActiveDocumentText = null;
            useDocumentContext = false;
            if (activeProject != null) await CosmosDb.UpsertProjectChatAsync(activeChat, activeProject.Id, currentUserId);
            else await CosmosDb.UpsertStandaloneChatAsync(activeChat, currentUserId);
        }
    }

    private void HandleUseDocumentContextChanged(bool value)
    {
        useDocumentContext = value;
    }

    private async Task SendMessage((string Prompt, int MaxSentences) args)
    {
        if (activeChat == null) return;

        isTyping = true;
        StateHasChanged();

        try
        {
            if (activeProject != null)
            {
                await ChatSvc.ProcessProjectMessageAsync(activeProject, activeChat, currentMessages, args.Prompt, currentUserId, useDocumentContext, args.MaxSentences);
            }
            else
            {
                await ChatSvc.ProcessStandaloneMessageAsync(activeChat, currentMessages, args.Prompt, currentUserId, useDocumentContext, args.MaxSentences);
            }
        }
        catch (Exception ex)
        {
            currentMessages.Add(new FunChatBotApp.Models.ChatMessage { Role = "assistant", Content = $"Hiba: {ex.Message}" });
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }
}
