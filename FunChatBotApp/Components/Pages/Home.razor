@page "/"
@using FunChatBotApp.Models
@using FunChatBotApp.Services
@using Markdig
@inject ChatService ChatSvc
@inject DocumentService DocSvc
@inject CosmosDbService CosmosDb
@rendermode InteractiveServer

<PageTitle>AI Chat Workspace</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Sidebar / Workspace Menu -->
        <div class="col-md-3 border-end" style="height: 85vh; overflow-y: auto;">
            <h4>Munkaterület</h4>

            <!-- Standalone Chats -->
            <div class="mb-4">
                <h5>Egyszerű chatek</h5>
                <div class="input-group mb-2">
                    <input type="text" class="form-control form-control-sm" @bind="newStandaloneChatTitle" placeholder="Új chat címe..." />
                    <button class="btn btn-sm btn-outline-primary" @onclick="CreateStandaloneChat">Létrehoz</button>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var chat in standaloneChats)
                    {
                        <li class="list-group-item list-group-item-action @(activeChat == chat ? "active text-white bg-primary" : "")" 
                            style="cursor: pointer;" @onclick="async () => await SelectChat(null, chat)">
                            @chat.Title
                        </li>
                    }
                </ul>
            </div>

            <!-- Projects -->
            <div>
                <h5>Projektek</h5>
                <div class="input-group mb-2">
                    <input type="text" class="form-control form-control-sm" @bind="newProjectName" placeholder="Új projekt neve..." />
                    <button class="btn btn-sm btn-outline-success" @onclick="CreateProject">Létrehoz</button>
                </div>

                @foreach (var proj in projects)
                {
                    <div class="card mb-2">
                        <div class="card-header d-flex justify-content-between align-items-center p-2">
                            <strong>@proj.Name</strong>
                            <button class="btn btn-sm btn-outline-secondary py-0" style="font-size: 0.8rem;" @onclick="() => PromptNewProjectChat(proj)">+ Chat</button>
                        </div>
                        @if (projectToCreateChatFor == proj)
                        {
                            <div class="card-body p-2 border-bottom">
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" @bind="newProjectChatTitle" placeholder="Chat címe..." />
                                    <button class="btn btn-outline-primary" @onclick="CreateProjectChat">Hozzáad</button>
                                    <button class="btn btn-outline-danger" @onclick="() => projectToCreateChatFor = null">X</button>
                                </div>
                            </div>
                        }
                        <ul class="list-group list-group-flush">
                            @if (projectChatsByProject.ContainsKey(proj.Id))
                            {
                                @foreach (var pChat in projectChatsByProject[proj.Id])
                                {
                                    <li class="list-group-item list-group-item-action p-2 @(activeChat == pChat ? "active text-white bg-primary" : "")"
                                        style="cursor: pointer; padding-left: 20px;" @onclick="async () => await SelectChat(proj, pChat)">
                                        @pChat.Title
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-9 d-flex flex-column" style="height: 85vh;">
            @if (activeChat == null)
            {
                <div class="d-flex justify-content-center align-items-center h-100 border rounded bg-light">
                    <h4 class="text-muted">Válassz ki vagy hozz létre egy chatet a kezdéshez!</h4>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <h4>@activeChat.Title <span class="text-muted" style="font-size: 1rem;">@(activeProject != null ? $" ({activeProject.Name} projekt)" : "")</span></h4>
                    @if (activeProject != null && !string.IsNullOrEmpty(activeProject.JointSummary))
                    {
                        <button class="btn btn-sm btn-info" title="@activeProject.JointSummary" @onclick="() => showSummary = !showSummary">
                            @(showSummary ? "Memória elrejtése" : "Memória mutatása")
                        </button>
                    }
                </div>

                @if (showSummary && activeProject != null)
                {
                    <div class="alert alert-secondary p-2 mb-2" style="max-height: 150px; overflow-y: auto;">
                        <strong>Közös projekt memória:</strong><br />
                        @activeProject.JointSummary
                    </div>
                }

                <div class="chat-box flex-grow-1 border rounded p-3 mb-3 d-flex flex-column" style="overflow-y: auto; background: #f8f9fa;">
                    @if (currentMessages.Count == 0)
                    {
                        <div class="text-center text-muted mt-5">Nincsenek üzenetek ebben a chatben. Írj valamit a kezdéshez!</div>
                    }
                    @foreach (var msg in currentMessages.Where(m => m.Role != "system"))
                    {
                        <div class="mb-2 text-@(msg.Role == "user" ? "end" : "start")">
                            <span class="badge @(msg.Role == "user" ? "bg-primary" : "bg-light text-dark border") p-2 text-start text-wrap" 
                                  style="font-size: 1rem; max-width: 80%;">
                                @if (msg.Role == "user")
                                {
                                    @msg.Content
                                }
                                else
                                {
                                    <!-- A Markdig konvertálja a Markdown-t HTML-re, a (MarkupString) pedig utasítja a Blazort, hogy renderelje le -->
                                    @((MarkupString)Markdown.ToHtml(msg.Content ?? ""))
                                }
                            </span>
                        </div>
                    }
                    @if (isTyping)
                    {
                        <div class="text-start mb-2">
                            <span class="badge bg-secondary p-2">Az MI gépel...</span>
                        </div>
                    }
                </div>

                <!-- File & Input Area -->
                <div class="mt-auto">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <InputFile OnChange="HandleFileSelected" class="form-control form-control-sm" accept=".pdf,.docx,.txt,.pptx" style="max-width: 250px;" />
                            @if (!string.IsNullOrEmpty(activeChat.ActiveDocumentText))
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="ClearDocument" title="Dokumentum eltávolítása a chatből">X</button>
                            }
                        </div>

                        <div class="form-check form-switch ms-3">
                            <input class="form-check-input" type="checkbox" id="docToggle" @bind="useDocumentContext" disabled="@(string.IsNullOrEmpty(activeChat.ActiveDocumentText))">
                            <label class="form-check-label @(useDocumentContext ? "text-danger fw-bold" : "")" for="docToggle" title="Kapcsold be, hogy a fájl tartalma minden kérdéshez el legyen küldve!">
                                Dokumentum kontextus @(useDocumentContext ? "(Aktív)" : "(Inaktív)")
                            </label>
                        </div>
                    </div>
                    @if (isProcessingFile)
                    {
                        <div class="alert alert-info py-1 mb-2">Fájl feldolgozása folyamatban...</div>
                    }

                    <div class="input-group">
                        <input type="text" class="form-control" @bind="userInput" @bind:event="oninput" @onkeyup="HandleKeyUp" placeholder="Írj egy üzenetet..." disabled="@isTyping" />
                        <button class="btn btn-primary" @onclick="SendMessage" disabled="@(isTyping || string.IsNullOrWhiteSpace(userInput))">Küldés</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Project> projects = new();
    private List<ChatSession> standaloneChats = new();

    // Kényelmi szótár a projektek chatjeinek tárolásához a UI-ban
    private Dictionary<string, List<ChatSession>> projectChatsByProject = new();

    // Az éppen aktív chat üzeneteinek listája
    private List<ChatMessage> currentMessages = new();

    // Állapotok a bal panelhez
    private string newStandaloneChatTitle = "";
    private string newProjectName = "";
    private Project? projectToCreateChatFor = null;
    private string newProjectChatTitle = "";

    // Aktív kiválasztás
    private Project? activeProject = null;
    private ChatSession? activeChat = null;

    // UI állapotok
    private string userInput = "";
    private bool useDocumentContext = false;
    private bool isTyping = false;
    private bool isProcessingFile = false;
    private bool showSummary = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        projects = await CosmosDb.GetProjectsAsync();
        standaloneChats = await CosmosDb.GetStandaloneChatsAsync();

        // Minden projekthez lekérjük a chatjeit
        projectChatsByProject.Clear();
        foreach (var proj in projects)
        {
            var pChats = await CosmosDb.GetProjectChatsAsync(proj.Id);
            projectChatsByProject[proj.Id] = pChats;
        }
    }

    private async Task CreateStandaloneChat()
    {
        if (string.IsNullOrWhiteSpace(newStandaloneChatTitle)) return;
        var chat = new ChatSession { Title = newStandaloneChatTitle };
        await CosmosDb.UpsertStandaloneChatAsync(chat);
        standaloneChats.Add(chat);
        newStandaloneChatTitle = "";
        await SelectChat(null, chat);
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName)) return;
        var proj = new Project { Name = newProjectName };
        await CosmosDb.UpsertProjectAsync(proj);
        projects.Add(proj);
        newProjectName = "";
    }

    private void PromptNewProjectChat(Project proj)
    {
        projectToCreateChatFor = proj;
        newProjectChatTitle = "";
    }

    private async Task CreateProjectChat()
    {
        if (projectToCreateChatFor == null || string.IsNullOrWhiteSpace(newProjectChatTitle)) return;

        var pChat = new ChatSession { Title = newProjectChatTitle };
        await CosmosDb.UpsertProjectChatAsync(pChat, projectToCreateChatFor.Id);

        if (!projectChatsByProject.ContainsKey(projectToCreateChatFor.Id))
            projectChatsByProject[projectToCreateChatFor.Id] = new List<ChatSession>();

        projectChatsByProject[projectToCreateChatFor.Id].Add(pChat);
        newProjectChatTitle = "";

        var proj = projectToCreateChatFor;
        projectToCreateChatFor = null; // input elrejtése
        await SelectChat(proj, pChat);
    }

    private async Task SelectChat(Project? project, ChatSession chat)
    {
        activeProject = project;
        activeChat = chat;
        showSummary = false;
        userInput = "";
        useDocumentContext = !string.IsNullOrEmpty(chat.ActiveDocumentText);

        currentMessages.Clear();
        var projectIdForQueries = project != null ? project.Id : chat.Id;
        currentMessages = await CosmosDb.GetChatMessagesAsync(projectIdForQueries, chat.Id);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (activeChat == null) return;

        isProcessingFile = true;
        try
        {
            using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            activeChat.ActiveDocumentText = await DocSvc.ExtractTextFromStreamAsync(stream);
            useDocumentContext = true; // Auto-bekapcsolás csatolás után

            // Mentjük az új állapotot
            if (activeProject != null) await CosmosDb.UpsertProjectChatAsync(activeChat, activeProject.Id);
            else await CosmosDb.UpsertStandaloneChatAsync(activeChat);
        }
        catch (Exception ex)
        {
            activeChat.ActiveDocumentText = $"Hiba: {ex.Message}";
        }
        finally
        {
            isProcessingFile = false;
            StateHasChanged();
        }
    }

    private async Task ClearDocument()
    {
        if (activeChat != null)
        {
            activeChat.ActiveDocumentText = null;
            useDocumentContext = false;
            if (activeProject != null) await CosmosDb.UpsertProjectChatAsync(activeChat, activeProject.Id);
            else await CosmosDb.UpsertStandaloneChatAsync(activeChat);
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || activeChat == null) return;

        string prompt = userInput;

        userInput = "";
        isTyping = true;
        StateHasChanged(); // Frissítés, hogy látszódjon a töltés

        try
        {
            if (activeProject != null)
            {
                await ChatSvc.ProcessProjectMessageAsync(activeProject, activeChat, currentMessages, prompt, useDocumentContext);
            }
            else
            {
                await ChatSvc.ProcessStandaloneMessageAsync(activeChat, currentMessages, prompt, useDocumentContext);
            }
        }
        catch (Exception ex)
        {
            currentMessages.Add(new FunChatBotApp.Models.ChatMessage { Role = "assistant", Content = $"Hiba: {ex.Message}" });
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }
}