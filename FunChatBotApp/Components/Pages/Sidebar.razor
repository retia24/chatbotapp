@using FunChatBotApp.Models

<div class="col-md-3 bg-light border-end p-3 d-flex flex-column sidebar-wrapper">
    <h4 class="mb-4 fw-bold text-dark">Munkaterület</h4>

    <!-- Standalone Chats -->
    <div class="mb-4">
        <h6 class="text-uppercase text-muted fw-bold mb-3 section-title">Egyszerű chatek</h6>
        <div class="input-group mb-3 shadow-sm rounded">
            <input type="text" class="form-control border-0" @bind="NewStandaloneChatTitle" placeholder="Új chat címe..." />
            <button class="btn btn-primary px-3" @onclick="CreateStandaloneChat">Létrehoz</button>
        </div>
        <ul class="list-group list-group-flush rounded shadow-sm">
            @foreach (var chat in StandaloneChats)
            {
                <li class="list-group-item list-group-item-action d-flex align-items-center chat-item @(ActiveChat == chat ? "active fw-bold" : "border-0")" 
                    @onclick="() => SelectChat(null, chat)">
                    <i class="bi bi-chat-left-text me-2"></i> @chat.Title
                </li>
            }
        </ul>
    </div>

    <!-- Projects -->
    <div>
        <h6 class="text-uppercase text-muted fw-bold mb-3 section-title">Projektek</h6>
        <div class="input-group mb-3 shadow-sm rounded">
            <input type="text" class="form-control border-0" @bind="NewProjectName" placeholder="Új projekt neve..." />
            <button class="btn btn-success px-3" @onclick="CreateProject">Létrehoz</button>
        </div>

        @foreach (var proj in Projects)
        {
            <div class="card border-0 shadow-sm mb-3 rounded-3">
                <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-2 rounded-top-3">
                    <strong class="text-dark">@proj.Name</strong>
                    <button class="btn btn-sm btn-light text-primary rounded-circle d-flex align-items-center justify-content-center add-chat-btn" title="Új chat ehhez a projekthez" @onclick="() => PromptNewProjectChat(proj)">+</button>
                </div>
                @if (ProjectToCreateChatFor == proj)
                {
                    <div class="card-body p-2 bg-light border-bottom">
                        <div class="input-group input-group-sm shadow-sm rounded">
                            <input type="text" class="form-control border-0" @bind="NewProjectChatTitle" placeholder="Chat címe..." />
                            <button class="btn btn-primary" @onclick="CreateProjectChat">Hozzáad</button>
                            <button class="btn btn-danger" @onclick="() => ProjectToCreateChatFor = null">X</button>
                        </div>
                    </div>
                }
                <ul class="list-group list-group-flush rounded-bottom-3">
                    @if (ProjectChatsByProject.ContainsKey(proj.Id))
                    {
                        @foreach (var pChat in ProjectChatsByProject[proj.Id])
                        {
                            <li class="list-group-item list-group-item-action border-0 py-2 project-chat-item @(ActiveChat == pChat ? "active fw-bold" : "bg-light")"
                                @onclick="() => SelectChat(proj, pChat)">
                                <i class="bi bi-chat-dots me-2 text-muted"></i> @pChat.Title
                            </li>
                        }
                    }
                </ul>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<ChatSession> StandaloneChats { get; set; } = new();
    [Parameter] public List<Project> Projects { get; set; } = new();
    [Parameter] public Dictionary<string, List<ChatSession>> ProjectChatsByProject { get; set; } = new();
    [Parameter] public ChatSession? ActiveChat { get; set; }

    [Parameter] public EventCallback<string> OnCreateStandaloneChat { get; set; }
    [Parameter] public EventCallback<string> OnCreateProject { get; set; }
    [Parameter] public EventCallback<(Project Project, string Title)> OnCreateProjectChat { get; set; }
    [Parameter] public EventCallback<(Project? Project, ChatSession Chat)> OnSelectChat { get; set; }

    private string NewStandaloneChatTitle = "";
    private string NewProjectName = "";
    private Project? ProjectToCreateChatFor = null;
    private string NewProjectChatTitle = "";

    private async Task CreateStandaloneChat()
    {
        if (string.IsNullOrWhiteSpace(NewStandaloneChatTitle)) return;
        await OnCreateStandaloneChat.InvokeAsync(NewStandaloneChatTitle);
        NewStandaloneChatTitle = "";
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(NewProjectName)) return;
        await OnCreateProject.InvokeAsync(NewProjectName);
        NewProjectName = "";
    }

    private void PromptNewProjectChat(Project proj)
    {
        ProjectToCreateChatFor = proj;
        NewProjectChatTitle = "";
    }

    private async Task CreateProjectChat()
    {
        if (ProjectToCreateChatFor == null || string.IsNullOrWhiteSpace(NewProjectChatTitle)) return;
        await OnCreateProjectChat.InvokeAsync((ProjectToCreateChatFor, NewProjectChatTitle));
        ProjectToCreateChatFor = null;
        NewProjectChatTitle = "";
    }

    private async Task SelectChat(Project? proj, ChatSession chat)
    {
        await OnSelectChat.InvokeAsync((proj, chat));
    }
}