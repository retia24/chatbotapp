@inherits LayoutComponentBase

<div class="page d-flex flex-column" style="height: 100vh;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm z-3" style="background-image: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 100%);">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href=""><i class="bi bi-robot me-2"></i>FunChatBotApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <NavLink class="nav-link px-3" href="" Match="NavLinkMatch.All">
                                <i class="bi bi-house-door me-1"></i> Home
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link px-3" href="vtt">
                                <i class="bi bi-mic me-1"></i> VTT
                            </NavLink>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-white">
                        <FunChatBotApp.Components.Layout.ThemeToggle @rendermode="InteractiveServer" />
                        <AuthorizeView>
                            <Authorized>
                                <a class="text-white text-decoration-none me-3" href="Account/Profile">
                                    <i class="bi bi-person-circle me-1"></i> Szia, @context.User.Identity?.Name!
                                </a>
                                @* Ideiglenes megoldás POST kéréshez egy form-mal API-n keresztül, vagy rendes Blazor Account/Logout *@
                                <form action="Account/Logout" method="post" class="m-0">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn-outline-light btn-sm">Kijelentkezés</button>
                                </form>
                            </Authorized>
                            <NotAuthorized>
                                <a class="btn btn-outline-light btn-sm me-2" href="Account/Register">Regisztráció</a>
                                <a class="btn btn-primary btn-sm" href="Account/Login">Bejelentkezés</a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 overflow-auto bg-body-tertiary">
        <article class="content p-4 h-100">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

